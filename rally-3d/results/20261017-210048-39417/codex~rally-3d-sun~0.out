+    } else if (tMaxY < tMaxX) {
+      j += stepY;
+      distance = tMaxY;
+      tMaxY += tDeltaY;
+    } else {
+      // A ray through a grid corner crosses both cell boundaries at once.
+      i += stepX;
+      j += stepY;
+      distance = tMaxX;
+      tMaxX += tDeltaX;
+      tMaxY += tDeltaY;
+    }
