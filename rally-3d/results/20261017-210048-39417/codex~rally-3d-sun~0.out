diff --git a/src/shade.js b/src/shade.js
index 3b46da64465f7ab6e93e3161530a27b14d8a153d..ace2fc6e1b7a1cf527c868d79814fb7dfce8da25
--- a/src/shade.js
+++ b/src/shade.js
@@ -2,8 +2,101 @@
 import { fromFrame, cellOf } from './geometry.js';
 
 // Share of court samples shaded by trees/buildings at `date`, or null when the
-// sun is down. Not implemented yet.
+// sun is down.
 
+const SAMPLE_SPACING = 1; // metres
+const NO_OBSTACLE = -32768;
+
+/** Whether the obstacle in a grid cell reaches above the ray at distance t. */
+function blocksAt(top, index, z, tanAlt, t) {
+  const height = top[index];
+  if (height === undefined || height === NO_OBSTACLE) return false;
+  return height > (z + t * tanAlt) * 10;
+}
+
+/**
+ * Walk the ray from (x, y) toward the sun through the obstacle grid. Grid
+ * traversal is done cell by cell so no obstacle between the point and the edge
+ * of the venue can be skipped.
+ */
+function isShaded(scene, x, y, z, dx, dy, tanAlt) {
+  const { radius, cell, g, top } = scene;
+  let i = Math.floor((x + radius) / cell);
+  let j = Math.floor((radius - y) / cell);
+  if (i < 0 || j < 0 || i >= g || j >= g) return false;
+
+  let distance = 0;
+  let stepX = 0;
+  let stepY = 0;
+  let tMaxX = Infinity;
+  let tMaxY = Infinity;
+  let tDeltaX = Infinity;
+  let tDeltaY = Infinity;
+
+  if (dx > 0) {
+    stepX = 1;
+    tMaxX = (-radius + (i + 1) * cell - x) / dx;
+    tDeltaX = cell / dx;
+  } else if (dx < 0) {
+    stepX = -1;
+    tMaxX = (-radius + i * cell - x) / dx;
+    tDeltaX = -cell / dx;
+  }
+
+  if (dy > 0) {
+    stepY = -1;
+    tMaxY = (radius - j * cell - y) / dy;
+    tDeltaY = cell / dy;
+  } else if (dy < 0) {
+    stepY = 1;
+    tMaxY = (radius - (j + 1) * cell - y) / dy;
+    tDeltaY = -cell / dy;
+  }
+
+  for (let steps = 0; steps <= 2 * g; steps++) {
+    if (blocksAt(top, j * g + i, z, tanAlt, distance)) return true;
+
+    if (tMaxX < tMaxY) {
+      i += stepX;
+      distance = tMaxX;
+      tMaxX += tDeltaX;
+    } else {
+      j += stepY;
+      distance = tMaxY;
+      tMaxY += tDeltaY;
+    }
+
+    if (i < 0 || j < 0 || i >= g || j >= g) return false;
+  }
+
+  return false;
+}
+
 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
+  if (alt <= 0) return null;
+
+  const dx = Math.sin(bearing);
+  const dy = Math.cos(bearing);
+  const tanAlt = Math.tan(alt);
+
+  let samples = 0;
+  let shaded = 0;
+
+  for (const court of scene.courts) {
+    const along = Math.max(1, Math.ceil(court.pl / SAMPLE_SPACING));
+    const across = Math.max(1, Math.ceil(court.pw / SAMPLE_SPACING));
+
+    for (let a = 0; a < along; a++) {
+      const localA = -court.pl / 2 + (a + 0.5) * court.pl / along;
+      for (let b = 0; b < across; b++) {
+        const localB = -court.pw / 2 + (b + 0.5) * court.pw / across;
+        const [x, y] = fromFrame(court, localA, localB);
+        samples++;
+        if (isShaded(scene, x, y, court.z, dx, dy, tanAlt)) shaded++;
+      }
+    }
+  }
+
+  return samples === 0 ? 0 : shaded / samples;
 }
