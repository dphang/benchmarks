import { shadeAt } from './src/shade.js';
const court = { sport:'tennis', cx:0, cy:0, theta:0, pl:20, pw:10, AL:30, AW:15, z:0 };
function scene(topValue, cells) {
  const radius=40, cell=2, g=40;
  const top=new Array(g*g).fill(-32768);
  for (const [x,y] of cells) {
    const i=Math.floor((x+radius)/cell), j=Math.floor((radius-y)/cell);
    top[j*g+i]=topValue;
  }
  return {lat:47.6,lng:-122.3,radius,cell,g,courts:[court],top};
