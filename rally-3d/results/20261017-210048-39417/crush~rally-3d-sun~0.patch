 import { sunPosition } from './sun.js';
 import { fromFrame, cellOf } from './geometry.js';
 
-// Share of court samples shaded by trees/buildings at `date`, or null when the
-// sun is down. Not implemented yet.
+const NONE = -32768;
+
+function isShaded(scene, x, y, h0, dx, dy, slope) {
+  const { radius, cell, g, top } = scene;
+  const maxDist = 2 * radius;
+
+  const start = cellOf(scene, x, y);
+  if (start === -1) return false;
+  let i = start % g;
+  let j = (start - i) / g;
+
+  const stepI = dx > 0 ? 1 : dx < 0 ? -1 : 0;
+  const stepJ = dy < 0 ? 1 : dy > 0 ? -1 : 0;
+
+  let tMaxI = Infinity;
+  let tDeltaI = Infinity;
+  if (dx > 0) {
+    tMaxI = (-radius + (i + 1) * cell - x) / dx;
+    tDeltaI = cell / dx;
+  } else if (dx < 0) {
+    tMaxI = (-radius + i * cell - x) / dx;
+    tDeltaI = -cell / dx;
+  }
+
+  let tMaxJ = Infinity;
+  let tDeltaJ = Infinity;
+  if (dy > 0) {
+    tMaxJ = (radius - j * cell - y) / dy;
+    tDeltaJ = cell / dy;
+  } else if (dy < 0) {
+    tMaxJ = (radius - (j + 1) * cell - y) / dy;
+    tDeltaJ = -cell / dy;
+  }
+
+  let t = 0;
+  for (;;) {
+    const h = top[j * g + i];
+    if (h !== NONE && h / 10 > h0 + t * slope) return true;
+
+    if (tMaxI < tMaxJ) {
+      i += stepI;
+      t = tMaxI;
+      tMaxI += tDeltaI;
+    } else {
+      j += stepJ;
+      t = tMaxJ;
+      tMaxJ += tDeltaJ;
+    }
+
+    if (i < 0 || j < 0 || i >= g || j >= g || t > maxDist) return false;
+  }
+}
 
 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
+  if (alt <= 0) return null;
+
+  const dx = Math.sin(bearing);
+  const dy = Math.cos(bearing);
+  const slope = Math.tan(alt);
+
+  let shaded = 0;
+  let total = 0;
+
+  for (const court of scene.courts) {
+    const nA = Math.max(2, Math.ceil(court.pl));
+    const nB = Math.max(2, Math.ceil(court.pw));
+
+    for (let ia = 0; ia < nA; ia++) {
+      const a = -court.pl / 2 + ((ia + 0.5) * court.pl) / nA;
+      for (let ib = 0; ib < nB; ib++) {
+        const b = -court.pw / 2 + ((ib + 0.5) * court.pw) / nB;
+        const [x, y] = fromFrame(court, a, b);
+        total++;
+        if (isShaded(scene, x, y, court.z, dx, dy, slope)) shaded++;
+      }
+    }
+  }
+
+  return total === 0 ? 0 : shaded / total;
 }
