Pseudo:

```
function isPointInShadow(scene, x, y, z, bearing, tanAlt) {
  const dx = Math.sin(bearing);
  const dy = Math.cos(bearing);
  const cell = scene.cell;
  const radius = scene.radius;
  const g = scene.g;
  const top = scene.top;

  // Grid coordinates
  const u = (x + radius) / cell;
  const v = (radius - y) / cell;
  let i = Math.floor(u);
  let j = Math.floor(v);
  if (i < 0 || j < 0 || i >= g || j >= g) return false;

  // Direction in grid units per metre
  const du = dx / cell;
  const dv = -dy / cell;

  let tMaxX = Infinity;
  let tMaxY = Infinity;
  let tDeltaX = Infinity;
  let tDeltaY = Infinity;
  let stepI = 0, stepJ = 0;

  if (du > 0) {
    tMaxX = ((i + 1) - u) / du; // distance along ray to next vertical line
    tDeltaX = 1 / du;
    stepI = 1;
  } else if (du < 0) {
    tMaxX = (i - u) / du; // du negative, u - i positive? Let's derive: next 
line at i, distance (i - u)/du. Since i <= u, numerator <=0, du<0 => positive.
    tDeltaX = -1 / du;
    stepI = -1;
  }

  if (dv > 0) {
    tMaxY = ((j + 1) - v) / dv;
    tDeltaY = 1 / dv;
    stepJ = 1;
  } else if (dv < 0) {
    tMaxY = (j - v) / dv;
    tDeltaY = -1 / dv;
    stepJ = -1;
  }

  const maxD = radius * 2; // or while
  // skip starting cell: advance to next cell
  while (true) {
    let d;
    if (tMaxX < tMaxY) {
      d = tMaxX;
      if (d > maxD) break;
      i += stepI;
      tMaxX += tDeltaX;
    } else {
      d = tMaxY;
      if (d > maxD) break;
      j += stepJ;
      tMaxY += tDeltaY;
    }
    if (i < 0 || j < 0 || i >= g || j >= g) return false; // exited venue before
obstacle
    const idx = j * g + i;
    const h = top[idx];
    if (h !== -32768 && h / 10 > z + d * tanAlt) return true;
  }
  return false;
}
```

