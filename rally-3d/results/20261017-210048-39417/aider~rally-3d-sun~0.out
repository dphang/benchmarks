Now, sample grid. Implement:

```
function shadeAt(scene, date) {
  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
  if (alt <= 0) return null;

  const dx = Math.sin(bearing);
  const dy = Math.cos(bearing);
  const tanAlt = Math.tan(alt);

  let total = 0;
  let shaded = 0;

  for (const court of scene.courts) {
    const { pl, pw, z = 0 } = court;
    const nA = Math.max(1, Math.round(pl)); // ~1 m spacing
    const nB = Math.max(1, Math.round(pw));
    for (let ia = 0; ia < nA; ia++) {
      const a = -pl / 2 + (ia + 0.5) * pl / nA;
      for (let ib = 0; ib < nB; ib++) {
        const b = -pw / 2 + (ib + 0.5) * pw / nB;
        const [x, y] = fromFrame(court, a, b);
        total++;
        if (isShaded(scene, x, y, z, dx, dy, tanAlt)) shaded++;
      }
    }
  }

  return total === 0 ? 0 : shaded / total;
}
```

