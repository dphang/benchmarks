Implementation details:

```
function isShaded(scene, x, y, z, dx, dy, tanAlt) {
  const { radius, cell, g, top } = scene;
  const u = (x + radius) / cell;
  const v = (radius - y) / cell;
  const i0 = Math.floor(u);
  const j0 = Math.floor(v);
  if (i0 < 0 || j0 < 0 || i0 >= g || j0 >= g) return false;

  // Check the cell containing the sample point (distance 0).
  const startTop = top[j0 * g + i0];
  if (startTop !== -32768 && startTop / 10 > z) return true;

  const du = dx / cell;
  const dv = -dy / cell;

  let i = i0;
  let j = j0;
  let tMaxX = Infinity;
  let tMaxY = Infinity;
  let tDeltaX = Infinity;
  let tDeltaY = Infinity;
  let stepI = 0;
  let stepJ = 0;

  if (du > 0) {
    tMaxX = ((i + 1) - u) / du;
    tDeltaX = 1 / du;
    stepI = 1;
  } else if (du < 0) {
    tMaxX = (i - u) / du;
    tDeltaX = -1 / du;
    stepI = -1;
  }

  if (dv > 0) {
    tMaxY = ((j + 1) - v) / dv;
    tDeltaY = 1 / dv;
    stepJ = 1;
  } else if (dv < 0) {
    tMaxY = (j - v) / dv;
    tDeltaY = -1 / dv;
    stepJ = -1;
  }

  while (true) {
    let d;
    if (tMaxX < tMaxY) {
      d = tMaxX;
      i += stepI;
      tMaxX += tDeltaX;
    } else {
      d = tMaxY;
      j += stepJ;
      tMaxY += tDeltaY;
    }

    if (i < 0 || j < 0 || i >= g || j >= g) return false;

    const h = top[j * g + i];
    if (h !== -32768 && h / 10 > z + d * tanAlt) return true;

    // safety: if d is Infinity or NaN
    if (!Number.isFinite(d)) return false;
  }
}
```

