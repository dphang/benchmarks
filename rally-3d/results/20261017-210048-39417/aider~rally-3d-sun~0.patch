+src/shade.js
+````
+import { sunPosition } from './sun.js';
+import { fromFrame } from './geometry.js';
+
+const NONE = -32768;
+const SAMPLES_PER_METRE = 2;
+
+// March the sun ray through the obstacle grid with a DDA / voxel traversal.
+// `d` is distance in metres from the court sample point.
+function inShadow(scene, x, y, z, dx, dy, tanAlt) {
+  const { radius, cell, g, top } = scene;
+
+  const u = (x + radius) / cell;
+  const v = (radius - y) / cell;
+
+  let i = Math.floor(u);
+  let j = Math.floor(v);
+
+  if (i < 0 || j < 0 || i >= g || j >= g) return false;
+
+  // The cell containing the sample point is at effectively zero distance.
+  const startTop = top[j * g + i];
+  if (startTop !== NONE && startTop / 10 > z) return true;
+
+  const du = dx / cell;
+  const dv = -dy / cell;
+
+  let tMaxX = Infinity;
+  let tMaxY = Infinity;
+  let tDeltaX = Infinity;
+  let tDeltaY = Infinity;
+  let stepI = 0;
+  let stepJ = 0;
+
+  if (du > 0) {
+    tMaxX = (i + 1 - u) / du;
+    tDeltaX = 1 / du;
+    stepI = 1;
+  } else if (du < 0) {
+    tMaxX = (i - u) / du;
+    tDeltaX = -1 / du;
+    stepI = -1;
+  }
+
+  if (dv > 0) {
+    tMaxY = (j + 1 - v) / dv;
+    tDeltaY = 1 / dv;
+    stepJ = 1;
+  } else if (dv < 0) {
+    tMaxY = (j - v) / dv;
+    tDeltaY = -1 / dv;
+    stepJ = -1;
+  }
+
+  while (true) {
+    let d;
+
+    if (tMaxX < tMaxY) {
+      d = tMaxX;
+      i += stepI;
+      tMaxX += tDeltaX;
+    } else {
+      d = tMaxY;
+      j += stepJ;
+      tMaxY += tDeltaY;
+    }
+
+    if (!Number.isFinite(d)) return false;
+    if (i < 0 || j < 0 || i >= g || j >= g) return false;
+
+    const h = top[j * g + i];
+    if (h !== NONE && h / 10 > z + d * tanAlt) return true;
+  }
+}
+
+export function shadeAt(scene, date) {
+  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
+  if (alt <= 0) return null;
+
+  const dx = Math.sin(bearing);
+  const dy = Math.cos(bearing);
+  const tanAlt = Math.tan(alt);
+
+  let total = 0;
+  let shaded = 0;
+
+  for (const court of scene.courts) {
+    const pl = court.pl;
+    const pw = court.pw;
+    const z = court.z ?? 0;
+
+    const nA = Math.max(1, Math.round(pl * SAMPLES_PER_METRE));
+    const nB = Math.max(1, Math.round(pw * SAMPLES_PER_METRE));
+
+    for (let ia = 0; ia < nA; ia++) {
+      const a = -pl / 2 + ((ia + 0.5) * pl) / nA;
+
+      for (let ib = 0; ib < nB; ib++) {
+        const b = -pw / 2 + ((ib + 0.5) * pw) / nB;
+        const [x, y] = fromFrame(court, a, b);
+
+        total++;
+        if (inShadow(scene, x, y, z, dx, dy, tanAlt)) shaded++;
+      }
+    }
+  }
+
+  return total === 0 ? 0 : shaded / total;
+}
+````
