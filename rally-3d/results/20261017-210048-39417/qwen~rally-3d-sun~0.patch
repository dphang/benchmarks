@@ -1,9 +1,57 @@
 import { sunPosition } from './sun.js';
 import { fromFrame, cellOf } from './geometry.js';
 
-// Share of court samples shaded by trees/buildings at `date`, or null when the
-// sun is down. Not implemented yet.
+// Court samples sit on a regular metric grid, so the pooled fraction weights
+// courts by area rather than by how the grid happens to fall on each one.
+const SAMPLE_SPACING = 1; // metres
 
+const NO_OBSTACLE = -32768;
+
+/**
+ * Walk from a court sample toward the sun and report whether an obstacle's top
+ * rises above the sun's ray before the venue grid ends.
+ */
+function inShadow(scene, x, y, z, dx, dy, tanAlt, step, maxDist) {
+  for (let dist = 0; dist <= maxDist; dist += step) {
+    const cell = cellOf(scene, x + dx * dist, y + dy * dist);
+    if (cell < 0) return false; // the venue ends before an obstacle is reached
+    const top = scene.top[cell];
+    if (top !== NO_OBSTACLE && top / 10 > z + dist * tanAlt) return true;
+  }
+  return false;
+}
+
+/** Share (0-1) of court samples in shadow at `date`, or null when the sun is down. */
 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
+  if (!(alt > 0)) return null;
+
+  // World axes: x east, y north. A bearing is clockwise from north.
+  const dx = Math.sin(bearing);
+  const dy = Math.cos(bearing);
+  const tanAlt = Math.tan(alt);
+  const step = scene.cell / 2;
+  const maxDist = 2 * scene.radius * Math.SQRT2;
+
+  let total = 0;
+  let shaded = 0;
+
+  for (const court of scene.courts) {
+    const na = Math.max(1, Math.round(court.pl / SAMPLE_SPACING));
+    const nb = Math.max(1, Math.round(court.pw / SAMPLE_SPACING));
+    const da = court.pl / na;
+    const db = court.pw / nb;
+
+    for (let i = 0; i < na; i++) {
+      const a = -court.pl / 2 + (i + 0.5) * da;
+      for (let j = 0; j < nb; j++) {
+        const b = -court.pw / 2 + (j + 0.5) * db;
+        const [x, y] = fromFrame(court, a, b);
+        total++;
+        if (inShadow(scene, x, y, court.z, dx, dy, tanAlt, step, maxDist)) shaded++;
+      }
+    }
+  }
+
+  return total === 0 ? 0 : shaded / total;
 }
diff --git a/src/sun.js b/src/sun.js
