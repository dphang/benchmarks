 import { sunPosition } from './sun.js';
 import { fromFrame, cellOf } from './geometry.js';
 
-// Share of court samples shaded by trees/buildings at `date`, or null when the
-// sun is down. Not implemented yet.
-
+/**
+ * Share of court sample points shaded by trees/buildings at `date`, or null
+ * when the sun is at or below the horizon.
+ */
 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+  const sun = sunPosition(date, scene.lat, scene.lng);
+  if (sun.alt <= 0) return null;
+
+  // Unit direction toward the sun in the ground plane, and the height gained
+  // per metre travelled along that ray.
+  const ex = Math.sin(sun.bearing);
+  const ny = Math.cos(sun.bearing);
+  const rise = Math.tan(sun.alt);
+
+  // No obstacle can shade a point from farther away than this, because the
+  // ray would already be above the tallest obstacle in the scene.
+  let maxTop = -32768 / 10;
+  for (const v of scene.top) {
+    if (v !== -32768 && v / 10 > maxTop) maxTop = v / 10;
+  }
+
+  let shaded = 0;
+  let samples = 0;
+
+  for (const f of scene.courts) {
+    // Sample the playing area on a roughly 1.4 m grid. The ray starts at eye
+    // height above the court surface.
+    const h0 = f.z + 1;
+    const maxD = Math.min(scene.radius * 1.5, (maxTop - h0) / rise);
+
+    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
+      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
+        const [px, py] = fromFrame(f, a, b);
+        samples++;
+
+        // March away from the point toward the sun. The ray climbs as it goes,
+        // so an obstacle only blocks it if its top is above the ray there.
+        for (let d = 0.5; d < maxD; d += 0.5) {
+          const c = cellOf(scene, px + ex * d, py + ny * d);
+          if (c < 0) break; // venue ends before any obstacle is reached
+          const top = scene.top[c];
+          if (top !== -32768 && top / 10 > h0 + d * rise) {
+            shaded++;
+            break;
+          }
+        }
+      }
+    }
+  }
+
+  return samples ? shaded / samples : 0;
 }
