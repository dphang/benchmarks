-// Sun position (the SunCalc formulas). Not implemented yet.
+// Sun position using the standard SunCalc formulas.
 
+export const rad = Math.PI / 180;
+
+const dayMs = 1000 * 60 * 60 * 24;
+const J1970 = 2440588;
+const J2000 = 2451545;
+
+/**
+ * Where the sun is at `date` for a venue at (lat, lng).
+ * Returns { alt, bearing }: elevation above the horizon and compass bearing
+ * (clockwise from north), both in radians.
+ */
 export function sunPosition(date, lat, lng) {
-  throw new Error('sunPosition is not implemented');
+  const d = date.valueOf() / dayMs - 0.5 + J1970 - J2000;
+
+  // Mean anomaly, equation of the centre, and ecliptic longitude.
+  const M = rad * (357.5291 + 0.98560028 * d);
+  const C = rad * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M));
+  const L = M + C + rad * 102.9372 + Math.PI;
+
+  // Ecliptic to equatorial coordinates.
+  const e = rad * 23.4397; // obliquity of the Earth
+  const dec = Math.asin(Math.sin(e) * Math.sin(L));
+  const ra = Math.atan2(Math.sin(L) * Math.cos(e), Math.cos(L));
+
+  // Hour angle and horizontal coordinates.
+  const H = rad * (280.16 + 360.9856235 * d) + rad * lng - ra;
+  const phi = rad * lat;
+  const alt = Math.asin(
+    Math.sin(phi) * Math.sin(dec) + Math.cos(phi) * Math.cos(dec) * Math.cos(H),
+  );
+  const az = Math.atan2(
+    Math.sin(H),
+    Math.cos(H) * Math.sin(phi) - Math.tan(dec) * Math.cos(phi),
+  );
+
+  // SunCalc's azimuth is measured from south toward west; convert it to a
+  // compass bearing measured clockwise from north.
+  return { alt, bearing: (az + Math.PI) % (2 * Math.PI) };
 }
