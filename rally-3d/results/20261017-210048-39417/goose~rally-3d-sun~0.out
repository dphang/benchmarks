// Sun position, using the standard SunCalc formulas (mean anomaly, equation of
// the centre, ecliptic longitude, declination, right ascension, hour angle).

const DAY_MS = 86400000;
const J1970 = 2440588; // Julian day of the Unix epoch
const J2000 = 2451545; // Julian day of the J2000 epoch

const RAD = Math.PI / 180;
const OBLIQUITY = RAD * 23.4397; // Earth's axial tilt
const PERIHELION = RAD * 102.9372; // perihelion of the Earth's orbit

const toDays = (date) => date.valueOf() / DAY_MS - 0.5 + J1970 - J2000;

/** Mean anomaly of the sun, radians. */
const solarMeanAnomaly = (d) => RAD * (357.5291 + 0.98560028 * d);

/** Ecliptic longitude of the sun, radians. */
function eclipticLongitude(M) {
  // Equation of the centre: the first three terms are plenty for our accuracy.
  const C = RAD * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M));
  return M + C + PERIHELION + Math.PI;
}

/** Declination of a point on the ecliptic, radians (latitude b = 0 for the sun). */
const declination = (L) => Math.asin(Math.sin(OBLIQUITY) * Math.sin(L));

/** Right ascension of a point on the ecliptic, radians (latitude b = 0). */
const rightAscension = (L) => Math.atan2(Math.cos(OBLIQUITY) * Math.sin(L), Math.cos(L));

/** Local sidereal time, radians. */
const siderealTime = (d, lw) => RAD * (280.16 + 360.9856235 * d) - lw;

/**
 * Where the sun is at `date` as seen from `(lat, lng)` (degrees).
 *
 * @returns {{ alt: number, bearing: number }} `alt` is the elevation above the
 *   horizon in radians (negative below it); `bearing` is the compass bearing
 *   toward the sun in radians, clockwise from north, in [0, 2pi).
 */
export function sunPosition(date, lat, lng) {
  const lw = RAD * -lng; // longitude, west-positive
  const phi = RAD * lat;
  const d = toDays(date);

  const L = eclipticLongitude(solarMeanAnomaly(d));
  const dec = declination(L);
  const ra = rightAscension(L);

  // Hour angle: how far the sun has turned since it crossed the meridian.
  const H = siderealTime(d, lw) - ra;

  const alt = Math.asin(
    Math.sin(phi) * Math.sin(dec) + Math.cos(phi) * Math.cos(dec) * Math.cos(H),
  );

  // SunCalc's azimuth is measured from south, positive toward the west; adding
  // half a turn turns it into a compass bearing clockwise from north.
  const azimuthFromSouth = Math.atan2(
    Math.sin(H),
    Math.cos(H) * Math.sin(phi) - Math.tan(dec) * Math.cos(phi),
  );
  let bearing = (azimuthFromSouth + Math.PI) % (2 * Math.PI);
  if (bearing < 0) bearing += 2 * Math.PI;

  return { alt, bearing };
}
