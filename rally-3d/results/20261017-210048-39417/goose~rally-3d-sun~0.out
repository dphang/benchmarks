import { fromFrame, cellOf } from './geometry.js';

// A cell with no obstacle at all is marked with the minimum int16 value.
const NO_OBSTACLE = -32768;

// Spacing of the sample grid that covers each court, in metres.
const SAMPLE_STEP = 1;

/** Tallest obstacle anywhere in the venue, in metres (may be -Infinity). */
function tallest(top) {
  let max = -Infinity;
  for (const height of top) {
    if (height !== NO_OBSTACLE && height / 10 > max) max = height / 10;
  }
  return max;
}

/**
 * Is the point at `(x, y, z)` in shadow, looking toward the sun?
 *
 * The sun's ray climbs `climb` metres per horizontal metre, so walking away
 * from the point along the sun's bearing it only ever gets higher. Within one
 * grid cell the obstacle top is a single number, so the ray is lowest where it
 * enters the cell: that is where an obstacle either blocks it or does not.
 * The ray is therefore walked cell by cell, and it is in shadow as soon as a
 * cell's top rises above it on entry. A ray that leaves the venue without
 * meeting one is in full sun.
 */
function inShadow(scene, x, y, z, dx, dy, climb, maxTop) {
  const { cell: size, g, radius, top } = scene;

  const start = cellOf(scene, x, y);
  if (start === -1) return false; // no venue data here, so nothing to hide behind
  let ci = start % g; // column, east-positive
  let cj = (start / g) | 0; // row, counted south from the north edge

  // Which way the ray moves through the grid (rows are numbered downwards),
  // how far apart the cell boundaries are along the ray, and where it crosses
  // the next one on each axis.
  const stepI = dx > 0 ? 1 : -1;
  const stepJ = dy > 0 ? -1 : 1;
  const deltaI = dx === 0 ? Infinity : size / Math.abs(dx);
  const deltaJ = dy === 0 ? Infinity : size / Math.abs(dy);
  let nextI = Infinity;
  let nextJ = Infinity;
  if (dx > 0) nextI = ((ci + 1) * size - (x + radius)) / dx;
  else if (dx < 0) nextI = (x + radius - ci * size) / -dx;
  if (dy > 0) nextJ = (radius - cj * size - y) / dy;
  else if (dy < 0) nextJ = (y - (radius - (cj + 1) * size)) / -dy;

  let t = 0; // distance along the ray, in metres
  for (;;) {
    const height = top[cj * g + ci];
    if (height !== NO_OBSTACLE && height / 10 > z + t * climb) return true;

    // Step into the next cell the ray enters.
    if (nextI < nextJ) {
      t = nextI;
      nextI += deltaI;
      ci += stepI;
    } else {
      t = nextJ;
      nextJ += deltaJ;
      cj += stepJ;
    }

    // The venue ends before any obstacle is reached: full sun.
    if (ci < 0 || cj < 0 || ci >= g || cj >= g) return false;
    // Nothing in the venue reaches this high: full sun.
    if (z + t * climb > maxTop) return false;
  }
}

/**
 * Share of the venue's courts that is in shadow at `date`.
 *
 * @param {object} scene A venue scene (lat, lng, radius, cell, g, courts, top).
 * @param {Date} date
 * @returns {number|null} The fraction (0-1) of court sample points in shadow,
 *   or null when the sun is at or below the horizon.
 */
export function shadeAt(scene, date) {
  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
  if (!(alt > 0)) return null; // sun down (or an unreadable date)

  // Horizontal unit vector toward the sun, with +x east and +y north and the
  // bearing measured clockwise from north, plus the ray's climb per metre.
  const dx = Math.sin(bearing);
  const dy = Math.cos(bearing);
  const climb = Math.tan(alt);
  const maxTop = tallest(scene.top);

  let shaded = 0;
  let total = 0;
  for (const court of scene.courts ?? []) {
    const z = court.z ?? 0;
    // A grid of cell-centre samples over the pl x pw footprint, in court-local
    // coordinates: a along the length, b across it.
    const na = Math.max(2, Math.round(court.pl / SAMPLE_STEP));
    const nb = Math.max(2, Math.round(court.pw / SAMPLE_STEP));
    for (let i = 0; i < na; i++) {
      const a = -court.pl / 2 + ((i + 0.5) * court.pl) / na;
      for (let j = 0; j < nb; j++) {
        const b = -court.pw / 2 + ((j + 0.5) * court.pw) / nb;
        const [x, y] = fromFrame(court, a, b);
        total++;
        if (inShadow(scene, x, y, z, dx, dy, climb, maxTop)) shaded++;
      }
    }
  }

  return total === 0 ? 0 : shaded / total;
}


