// Independent reference: exact ray/cell slab intersection over every grid cell,
// no distance sampling at all.
import { readFileSync } from 'node:fs';
import { sunPosition } from 'work/strong/goose/rally-3d-sun-0/src/sun.js';
import { fromFrame } from 'work/strong/goose/rally-3d-sun-0/src/geometry.js';

export function exactShade(scene, date) {
  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
  if (!(alt > 0)) return null;
  const dx = Math.sin(bearing), dy = Math.cos(bearing), k = Math.tan(alt);
  const R = scene.radius, c = scene.cell, G = scene.g;

  // cell rectangles
  const cells = [];
  for (let j = 0; j < G; j++) for (let i = 0; i < G; i++) {
    const h = scene.top[j * G + i];
    if (h === -32768) continue;
    cells.push({ x0: -R + i * c, x1: -R + (i + 1) * c, y0: R - (j + 1) * c, y1: R - j * c, h: h / 10 });
  }

  let shaded = 0, total = 0;
  for (const court of scene.courts) {
    const na = Math.max(2, Math.round(court.pl)), nb = Math.max(2, Math.round(court.pw));
    for (let i = 0; i < na; i++) for (let jj = 0; jj < nb; jj++) {
      const a = -court.pl / 2 + ((i + 0.5) * court.pl) / na;
      const b = -court.pw / 2 + ((jj + 0.5) * court.pw) / nb;
      const [x, y] = fromFrame(court, a, b);
      total++;
      let hit = false;
      for (const cell of cells) {
        if (cell.h <= court.z) continue;              // can never clear even at t=0
        // slab intersection of ray (x,y)+t(dx,dy) with the cell rectangle
        let t0 = 0, t1 = Infinity, ok = true;
        for (const [p, d, lo, hi] of [[x, dx, cell.x0, cell.x1], [y, dy, cell.y0, cell.y1]]) {
          if (Math.abs(d) < 1e-12) { if (p < lo || p > hi) { ok = false; break; } continue; }
          let ta = (lo - p) / d, tb = (hi - p) / d;
          if (ta > tb) [ta, tb] = [tb, ta];
          t0 = Math.max(t0, ta); t1 = Math.min(t1, tb);
          if (t0 > t1) { ok = false; break; }
        }
        if (ok && t1 >= t0 && cell.h > court.z + t0 * k) { hit = true; break; }
      }
      if (hit) shaded++;
    }
  }
  return total ? shaded / total : 0;
}
