    const mine = shadeAt(sc, d), slab = exactShade(sc, d), brute = bruteShade(sc, d);
    const f = (v) => (v === null ? 'null' : v.toFixed(4));
    const flag = mine !== null && Math.abs(mine - brute) > 1e-9 ? '  <-- ' + Math.abs(mine - brute).toFixed(4) : '';
    console.log(name.slice(0, 22).padEnd(23), String(h).padStart(2) + 'Z', 'dda', f(mine), 'slab', f(slab), 'brute', f(brute), flag);
  }
}
