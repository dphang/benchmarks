    command: cd work/strong/goose/rally-3d-sun-0 && cat > /tmp/diff.mjs <<'EOF'
import { readFileSync } from 'node:fs';
import { sunPosition } from 'work/strong/goose/rally-3d-sun-0/src/sun.js';
import { fromFrame } from 'work/strong/goose/rally-3d-sun-0/src/geometry.js';

// Independent reference: brute-force fine march, testing each newly entered cell
// at the moment of entry (converges to the exact value as the step shrinks).
function bruteShade(scene, date, step = 0.02) {
  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
  if (!(alt > 0)) return null;
  const dx = Math.sin(bearing), dy = Math.cos(bearing), k = Math.tan(alt);
  const { radius: R, cell: c, g, top } = scene;
  let shaded = 0, total = 0;
  for (const court of scene.courts) {
    const na = Math.max(2, Math.round(court.pl)), nb = Math.max(2, Math.round(court.pw));
    for (let i = 0; i < na; i++) for (let jj = 0; jj < nb; jj++) {
      const a = -court.pl / 2 + ((i + 0.5) * court.pl) / na;
      const b = -court.pw / 2 + ((jj + 0.5) * court.pw) / nb;
      const [x, y] = fromFrame(court, a, b);
      total++;
      let prev = -2, blocked = false;
      for (let t = 0; ; t += step) {
        const px = x + dx * t, py = y + dy * t;
        const ci = Math.floor((px + R) / c), cj = Math.floor((R - py) / c);
        if (ci < 0 || cj < 0 || ci >= g || cj >= g) break;
        const idx = cj * g + ci;
        if (idx !== prev) {                       // just entered this cell
          prev = idx;
          const h = top[idx];
          if (h !== -32768 && h / 10 > court.z + t * k) { blocked = true; break; }
        }
      }
      if (blocked) shaded++;
    }
  }
  return total ? shaded / total : 0;
}
export { bruteShade };
EOF
