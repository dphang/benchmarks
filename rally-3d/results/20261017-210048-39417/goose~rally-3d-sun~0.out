import { readFileSync } from 'node:fs';
import { sunPosition } from 'work/strong/goose/rally-3d-sun-0/src/sun.js';
import { fromFrame } from 'work/strong/goose/rally-3d-sun-0/src/geometry.js';

const sc = JSON.parse(readFileSync('work/strong/goose/rally-3d-sun-0/venues/kenmore-inglemoor-hs.json', 'utf8'));
const date = new Date(Date.UTC(2026, 6, 21, 0));
const { alt, bearing } = sunPosition(date, sc.lat, sc.lng);
const dx = Math.sin(bearing), dy = Math.cos(bearing), k = Math.tan(alt);
const { radius: R, cell: c, g, top } = sc;
console.log('alt', (alt * 180 / Math.PI).toFixed(3), 'bearing', (bearing * 180 / Math.PI).toFixed(3), 'dx', dx.toFixed(4), 'dy', dy.toFixed(4));

function dda(x, y, z, log) {
  const start = (() => { const i = Math.floor((x + R)/c), j = Math.floor((R - y)/c); return (i<0||j<0||i>=g||j>=g) ? -1 : j*g+i; })();
  if (start === -1) return null;
  let ci = start % g, cj = (start / g) | 0;
  const stepI = dx > 0 ? 1 : -1, stepJ = dy > 0 ? -1 : 1;
  const deltaI = dx === 0 ? Infinity : c / Math.abs(dx), deltaJ = dy === 0 ? Infinity : c / Math.abs(dy);
  let nextI = dx === 0 ? Infinity : dx > 0 ? (ci+1)*c - (x+R) : x + R - ci*c;
  let nextJ = dy === 0 ? Infinity : dy > 0 ? R - cj*c - y : y - (R - (cj+1)*c);
  let t = 0;
  if (log) console.log(`start cell i=${ci} j=${cj} nextI=${nextI.toFixed(3)} nextJ=${nextJ.toFixed(3)}`);
  for (;;) {
    const h = top[cj*g+ci];
    if (log) console.log(`  cell i=${ci} j=${cj} t=${t.toFixed(3)} h=${h/10} ray=${(z + t*k).toFixed(2)}`);
    if (h !== -32768 && h/10 > z + t*k) return true;
    if (nextI < nextJ) { t = nextI; nextI += deltaI; ci += stepI; } else { t = nextJ; nextJ += deltaJ; cj += stepJ; }
    if (ci < 0 || cj < 0 || ci >= g || cj >= g) return false;
    if (z + t*k > 400) return false;
  }
}
function brute(x, y, z, step = 0.001) {
  let prev = -2;
  for (let t = 0; ; t += step) {
    const px = x + dx*t, py = y + dy*t;
    const ci = Math.floor((px + R)/c), cj = Math.floor((R - py)/c);
    if (ci<0||cj<0||ci>=g||cj>=g) return false;
    const idx = cj*g+ci;
    if (idx !== prev) {
      prev = idx;
      const h = top[idx];
      if (h !== -32768 && h/10 > z + t*k) return true;
    }
    if (t > 500) return false;
  }
}

for (const court of sc.courts) {
  const na = Math.max(2, Math.round(court.pl)), nb = Math.max(2, Math.round(court.pw));
  for (let i = 0; i < na; i++) for (let jj = 0; jj < nb; jj++) {
    const a = -court.pl/2 + ((i+0.5)*court.pl)/na, b = -court.pw/2 + ((jj+0.5)*court.pw)/nb;
    const [x, y] = fromFrame(court, a, b);
    const d = dda(x, y, court.z, false), br = brute(x, y, court.z);
    if (d !== br) {
      console.log(`\nMISMATCH at court(${court.cx},${court.cy}) sample (${x.toFixed(3)},${y.toFixed(3)}) dda=${d} brute=${br}`);
      dda(x, y, court.z, true);
      process.exit(0);
    }
  }
}
console.log('no mismatches');
EOF
