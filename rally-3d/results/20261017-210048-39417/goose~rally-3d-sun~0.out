import { shadeAt } from 'work/strong/goose/rally-3d-sun-0/src/shade.js';
import { sunPosition } from 'work/strong/goose/rally-3d-sun-0/src/sun.js';
const R = 110, CELL = 2, G = 110;

function scene(h, wallY1 = -14) {
  const top = new Array(G * G).fill(-32768);
  for (let x = -100; x <= 100; x += CELL) for (let y = wallY1 - 6; y <= wallY1; y += CELL) {
    const i = Math.floor((x + R) / CELL), j = Math.floor((R - y) / CELL);
    if (i >= 0 && j >= 0 && i < G && j < G) top[j * G + i] = Math.round(h * 10);
  }
  return { lat: 47.6, lng: -122.3, radius: R, cell: CELL, g: G,
    courts: [{ sport: 'tennis', cx: 0, cy: 0, theta: 0, pl: 23.77, pw: 10.97, z: 0 }], top };
}

// Wall north face at y=-14, court's southernmost sample row at y=-4.9865.
// First shading appears when the wall's shadow just reaches that row:
//   h > (y_row - y_face) * tan(alt)
const date = new Date('2026-06-21T20:00:00Z');
const s = sunPosition(date, 47.6, -122.3);
const row = -5.485 + 0.5 * (10.97 / 11);
const predicted = (row - -14) * Math.tan(s.alt);
console.log(`sun alt ${(s.alt * 180 / Math.PI).toFixed(2)}deg; southernmost sample row y=${row.toFixed(3)}`);
console.log(`predicted first-shade wall height = ${predicted.toFixed(3)} m`);

let lo = 1, hi = 30;
for (let n = 0; n < 40; n++) {
  const mid = (lo + hi) / 2;
  if (shadeAt(scene(mid), date) > 0) hi = mid; else lo = mid;
}
console.log(`bisected threshold (cell-quantised top) = ${hi.toFixed(3)} m  -> delta ${(hi - predicted).toFixed(3)} m`);
// cell tops are stored in decimetres, so quantisation of +/- 0.05 m is expected,
// plus the ray drifts east so it hits the wall slightly sooner/later.
console.log(`shade at threshold height ${hi.toFixed(3)}m: ${shadeAt(scene(hi + 0.06), date).toFixed(4)}, just below: ${shadeAt(scene(hi - 0.06), date).toFixed(4)}`);
EOF
