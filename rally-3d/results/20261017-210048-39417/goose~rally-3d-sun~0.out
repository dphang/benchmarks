    path ~/I/x/r/w/s/g/r/src/shade.js
    before: /**
 * Is the point at `(x, y, z)` in shadow, looking toward the sun?
 *
 * The sun's ray climbs `climb` metres per horizontal metre. Walking away from
 * the point along the sun's bearing, an obstacle blocks it only once its top
 * rises above the ray; a ray that leaves the venue without meeting one is in
 * full sun.
 */
function inShadow(scene, x, y, z, dx, dy, climb, maxTop) {
  const step = scene.cell / TRACE_STEPS_PER_CELL;

  for (let t = 0; ; t += step) {
    const rayHeight = z + t * climb;
    // Nothing in the scene is tall enough to reach this high: full sun.
    if (rayHeight > maxTop) return false;

    const cell = cellOf(scene, x + dx * t, y + dy * t);
    // The venue ends before any obstacle is reached: full sun.
    if (cell === -1) return false;

    const top = scene.top[cell];
    if (top !== NO_OBSTACLE && top / 10 > rayHeight) return true;
  }
}
    after: /**
 * Is the point at `(x, y, z)` in shadow, looking toward the sun?
 *
 * The ray climbs `climb` metres per horizontal metre, so walking away from the
 * point along the sun's bearing it only ever gets higher: within one grid cell
 * (whose obstacle top is a single number) it is lowest where it enters. So the
 * ray is walked cell by cell, testing each cell on entry, and it is blocked as
 * soon as a cell's top rises above it there. A ray that leaves the venue
 * without meeting one is in full sun.
 */
function inShadow(scene, x, y, z, dx, dy, climb, maxTop) {
  const { cell: size, g, radius, top } = scene;

  const start = cellOf(scene, x, y);
  if (start === -1) return false; // no venue data here, so nothing to hide behind
  let ci = start % g; // column, east-positive
  let cj = (start / g) | 0; // row, counted south from the north edge

  // Distance along the ray to the next cell boundary on each axis, how far
  // apart those boundaries are, and which way the row/column moves. Rows are
  // numbered downwards, so northward rays walk back through them.
  const stepI = dx > 0 ? 1 : -1;
  const stepJ = dy > 0 ? -1 : 1;
  const deltaI = dx === 0 ? Infinity : size / Math.abs(dx);
  const deltaJ = dy === 0 ? Infinity : size / Math.abs(dy);
  let nextI = dx === 0 ? Infinity
    : dx > 0 ? (ci + 1) * size - (x + radius) : x + radius - ci * size;
  let nextJ = dy === 0 ? Infinity
    : dy > 0 ? radius - cj * size - y : y - (radius - (cj + 1) * size);

  let t = 0; // how far along the ray we are, in metres
  for (;;) {
    const height = top[cj * g + ci];
    if (height !== NO_OBSTACLE && height / 10 > z + t * climb) return true;

    // Step into the next cell the ray enters.
    if (nextI < nextJ) {
      t = nextI;
      nextI += deltaI;
      ci += stepI;
    } else {
      t = nextJ;
      nextJ += deltaJ;
      cj += stepJ;
    }

    // The venue ends before any obstacle is reached: full sun.
    if (ci < 0 || cj < 0 || ci >= g || cj >= g) return false;
    // Nothing in the venue reaches this high: full sun.
    if (z + t * climb > maxTop) return false;
  }
}

