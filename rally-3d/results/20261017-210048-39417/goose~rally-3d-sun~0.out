import { sunPosition } from './src/sun.js';
import { readFileSync } from 'node:fs';
const ref = JSON.parse(readFileSync('/tmp/noaa.json','utf8'));
const D = 180/Math.PI;
for (const r of ref) {
  const s = sunPosition(new Date(r.iso), r.lat, r.lng);
  const dAlt = s.alt*D - r.altDeg;
