    content: import { sunPosition } from './sun.js';
import { fromFrame, cellOf } from './geometry.js';

// The obstacle grid has no height at all in a cell; the scene format marks it
// with the minimum int16 value.
const NO_OBSTACLE = -32768;

// Courtyard sample spacing, in metres along the court's length and across it.
const SAMPLE_STEP = 1;

// How finely the sun ray is walked across the obstacle grid, as a fraction of
// a cell. Half a cell cannot skip a whole cell, so no obstacle is stepped over.
const TRACE_STEPS_PER_CELL = 2;

// Sample points and the tallest obstacle only depend on the scene, not on the
// time of day, so they are computed once per scene: a forecast calls shadeAt
// many times with the same venue.
const sceneCache = new WeakMap();

function prepare(scene) {
  let prepared = sceneCache.get(scene);
  if (prepared) return prepared;

  const points = [];
  let maxTop = -Infinity; // metres

  for (const court of scene.courts ?? []) {
    // A grid of cell-centre samples covering the pl x pw footprint, in
    // court-local coordinates: a along the length, b across it.
    const na = Math.max(2, Math.round(court.pl / SAMPLE_STEP));
    const nb = Math.max(2, Math.round(court.pw / SAMPLE_STEP));
    for (let i = 0; i < na; i++) {
      const a = -court.pl / 2 + ((i + 0.5) * court.pl) / na;
      for (let j = 0; j < nb; j++) {
        const b = -court.pw / 2 + ((j + 0.5) * court.pw) / nb;
        const [x, y] = fromFrame(court, a, b);
        points.push({ x, y, z: court.z ?? 0 });
      }
    }
  }

  for (const top of scene.top) {
    if (top !== NO_OBSTACLE && top / 10 > maxTop) maxTop = top / 10;
  }

  prepared = { points, maxTop };
  sceneCache.set(scene, prepared);
  return prepared;
}

/**
 * Is the point at `(x, y, z)` in shadow, looking toward the sun?
 *
 * The sun's ray climbs `climb` metres per horizontal metre. Walking away from
 * the point along the sun's bearing, an obstacle blocks it only once its top
 * rises above the ray; a ray that leaves the venue without meeting one is in
 * full sun.
 */
function inShadow(scene, x, y, z, dx, dy, climb, maxTop) {
  const step = scene.cell / TRACE_STEPS_PER_CELL;

  for (let t = 0; ; t += step) {
    const rayHeight = z + t * climb;
    // Nothing in the scene is tall enough to reach this high: full sun.
    if (rayHeight > maxTop) return false;

    const cell = cellOf(scene, x + dx * t, y + dy * t);
    // The venue ends before any obstacle is reached: full sun.
    if (cell === -1) return false;

    const top = scene.top[cell];
    if (top !== NO_OBSTACLE && top / 10 > rayHeight) return true;
  }
}

/**
 * Share of the venue's courts that is shaded at `date`.
 *
 * @param {object} scene A venue scene (lat, lng, radius, cell, g, courts, top).
 * @param {Date} date
 * @returns {number|null} The fraction (0-1) of court sample points in shadow,
 *   or null when the sun is at or below the horizon.
 */
export function shadeAt(scene, date) {
  const { alt, bearing } = sunPosition(date, scene.lat, scene.lng);
  if (!(alt > 0)) return null; // sun down (or a NaN date)

  // Horizontal unit vector toward the sun: +x east, +y north, bearing
  // measured clockwise from north.
  const dx = Math.sin(bearing);
  const dy = Math.cos(bearing);
  const climb = Math.tan(alt); // metres of rise per horizontal metre

  const { points, maxTop } = prepare(scene);

  let shaded = 0;
  for (const p of points) {
    if (inShadow(scene, p.x, p.y, p.z, dx, dy, climb, maxTop)) shaded++;
  }

  return points.length === 0 ? 0 : shaded / points.length;
}


