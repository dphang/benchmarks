    command: cd work/strong/goose/rally-3d-sun-0 && cat > /tmp/rand.mjs <<'EOF'
import { shadeAt } from 'work/strong/goose/rally-3d-sun-0/src/shade.js';
import { exactShade } from '/tmp/exact.mjs';
import { sunPosition } from 'work/strong/goose/rally-3d-sun-0/src/sun.js';

// --- horizon boundary ---
const R = 110, CELL = 2, G = 110;
const bury = { lat: 47.6, lng: -122.3, radius: R, cell: CELL, g: G,
  courts: [{ sport: 'tennis', cx: 0, cy: 0, theta: 0, pl: 23, pw: 11, z: 0 }],
  top: new Array(G * G).fill(400) };
let lo = Date.UTC(2026, 5, 21, 11, 0), hi = Date.UTC(2026, 5, 21, 13, 0);
for (let n = 0; n < 60; n++) {
  const mid = (lo + hi) / 2;
  if (shadeAt(bury, new Date(mid)) === null) lo = mid; else hi = mid;
}
console.log(`sunrise bisected at ${new Date(hi).toISOString()} alt=${(sunPosition(new Date(hi), 47.6, -122.3).alt * 180 / Math.PI).toExponential(3)}deg`);
console.log(`  1s before: ${shadeAt(bury, new Date(hi - 1000))}   1s after: ${shadeAt(bury, new Date(hi + 1000))}`);

// --- randomised cross-check against exact ray/cell intersection ---
let seed = 12345;
const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
let worst = 0, worstCase = null, cases = 0;
for (let n = 0; n < 120; n++) {
  const top = new Array(G * G).fill(-32768);
  const nBlocks = 1 + Math.floor(rnd() * 6);
  for (let b = 0; b < nBlocks; b++) {
    const x0 = -100 + rnd() * 200, y0 = -100 + rnd() * 200;
    const w = 2 + rnd() * 40, d = 2 + rnd() * 40, h = 1 + rnd() * 30;
    for (let x = x0; x < x0 + w; x += CELL) for (let y = y0; y < y0 + d; y += CELL) {
      const i = Math.floor((x + R) / CELL), j = Math.floor((R - y) / CELL);
      if (i >= 0 && j >= 0 && i < G && j < G) top[j * G + i] = Math.max(top[j * G + i], Math.round(h * 10));
    }
  }
  const courts = [];
  const nCourts = 1 + Math.floor(rnd() * 3);
  for (let k = 0; k < nCourts; k++) {
    const pickle = rnd() < 0.5;
    courts.push({ sport: 'x', cx: -60 + rnd() * 120, cy: -60 + rnd() * 120, theta: rnd() * 2 * Math.PI,
      pl: pickle ? 13.41 : 23.77, pw: pickle ? 6.1 : 10.97, z: rnd() < 0.3 ? rnd() * 4 : 0 });
  }
  const scene = { lat: 40 + rnd() * 20, lng: -130 + rnd() * 40, radius: R, cell: CELL, g: G, courts, top };
  const date = new Date(Date.UTC(2026, Math.floor(rnd() * 12), 1 + Math.floor(rnd() * 28), Math.floor(rnd() * 24), Math.floor(rnd() * 60)));
  const a = shadeAt(scene, date), b = exactShade(scene, date);
  cases++;
  if (a === null || b === null) { if (a !== b) console.log('NULL MISMATCH', a, b); continue; }
  const d = Math.abs(a - b);
  if (d > worst) { worst = d; worstCase = { date: date.toISOString(), courts: courts.length, a, b }; }
}
console.log(`\n${cases} random scenes: worst |dda - exact| = ${worst.toExponential(2)}`, worst > 1e-12 ? JSON.stringify(worstCase) : '(exact agreement)');
EOF
