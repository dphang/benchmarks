+// Test against SunCalc reference implementation
+// https://github.com/noeldelgado/suncalc
+
+function testSunCalcComponents() {
+  const jdn0 = 2456704; 
+  const lowJulian = 2451545; // adjust
+   
+  // Use standard NYC Julian date reference
+  const date = new Date('2026-06-21T12:00:00 America/New_York'); // Noon EDT (UTC-4)
+  
+  console.log("Date:", date);
+  console.log("Timezone:", date.getTimezoneOffset(), "mins (UTC offset: -120/(-60), local: " + timeOffset(date) + ")");
+  
+  // Look at UTC noon on the same day
+  const utcNoon = new Date('2026-06-21T12:00:00Z');
+  console.log("\nUTC Noon:", utcNoon);
+  
+  // Julian Date for June 21st 2026
+  const JD0 = new Date();
+  // Subtract years virtually
+  for (let y=2050; y>2026; y--) {
+    JD0.setFullYear(y-1);
+  }
+  const jdn0_check = JD0.setFullYear(2026);
+  const jdn0 = new Date(2026, 5, 21, 12, 0, 0).toUTCString();
+  console.log("JS Date:", jdn0);
+  
+  // Re-read our formula with proper timestamp
+  function julianDate(date) {
+    const t = new Date(date);
+    const y = t.getUTCFullYear();
+    const m = t.getUTCMonth() + 1;
+    const d = t.getUTCDate();
+    const hh = t.getUTCHours();
+    const mm = t.getUTCMinutes();
+    const ss = t.getUTCSeconds();
+    
+    let A = Math.floor(y / 100);
+    let J = Math.floor(y - A + 0.001 * A * (A - 1) / 4) +
+            Math.floor((m + 1) / 12) * 365 +
+            Math.floor((m + 1) / 12) * (3 * ((m + 1) / 12) / 12 + 1) +
+            d - 0.5;
+    
+    J = J + Math.floor(30.6 * ((m + 1) / 12)) + 367 - 2 * A +
+          Math.floor(0.075 * (A % 100)) - Math.floor(J / 36524) * 3 + 71 - 1524.5;
+    
+    J = J + hh / 24 + mm / (60 * 24) + ss / (60 * 60 * 24);
+    return J;
+  }
+  
+  const JDN = julianDate(utcNoon);
+  console.log("JDN:", JDN);
+  
+  // Fresh small lune cycle test
+  const J0 = 2451545.0;
+  const T = (JDN - J0) / 36525;
+  console.log("T (centuries):", T);
+  
+  // Last is: Greenwich mean true longitude from RFC 5102
+  // L_GMT = 280.46061837477719 + 360.98564749999988 * JDN
+  const L_GMT = 280.46061837 + 360.98564749999988 * (JDN - J0);
+  console.log("L_GMT:", L_GMT);
+  const L_GMT_rad = L_GMT % 360; // normalize
+  console.log("L_GMT normalized:", L_GMT_rad);
+}
+
+testSunCalcComponents();
+
+function timeOffset(d) {
+  const local = (new Date(d.getTime() - d.getTimezoneOffset() * 60000)).getDate();
+  const utc = new Date(d.getTime() + (d.getTimezoneOffset() * 60000)).getDate();
+  const diff = local - utc;
+  return diff;
+}
