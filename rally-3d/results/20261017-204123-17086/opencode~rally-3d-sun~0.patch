+const RA = Math.atan2(Math.sin(L_rad) * Math.cos(23.439 * Math.PI / 180), Math.cos(L_rad)) * 180 / Math.PI;
+console.log("RA (deg):", RA);
+
+// GMST = 280.46061837 + 360.98564736629 * JDN
+const GMST = (280.46061837 + 360.98564736629 * (JDN - 2451545)) % 360;
+console.log("GMST (deg):", GMST);
+
+// Hour angle = GMST + longitude (Seattle = -122.3) - RA
+const lngRad = -122.3 * Math.PI / 180;
+const LST = (GMST + (-122.3)) % 360;
+console.log("LST (deg):", LST);
+
+let HA = ((LST - RA) + 360) % 360 - 180;
+console.log("Hour Angle (deg):", HA);
+console.log("Hour Angle (rad):", HA * Math.PI / 180);
