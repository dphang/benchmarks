+
+// M = 357.529 + D
+const M = 357.529 + D % 360;
+console.log("M (deg):", M);
+
+// RA calculation
+// L = 282.9404 + M + C
+// C from mean anomaly
+const C = 1.915 * Math.sin(M * Math.PI / 180) + 0.02 * Math.sin(2 * M * Math.PI / 180);
+const L = (282.9404 + M + C) % 360;
