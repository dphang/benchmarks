+
+function julianDate(date) {
+  const y = new Date(date).getUTCFullYear();
+  const m = new Date(date).getUTCMonth() + 1;
+  const d = new Date(date).getUTCDate();
+  const hh = new Date(date).getUTCHours();
+  const J = Math.floor(365.25 * (y + 4716)) +
+          Math.floor(30.6001 * (m + 1)) +
+          d +
+          Math.floor(2 - Math.floor(y / 100) + Math.floor(Math.floor(y / 100) / 4)) -
+          1524.5 +
+          hh / 24;
+  return J;
+}
+
+// June 21, 2026 Seattle local noon = UTC 17:00
