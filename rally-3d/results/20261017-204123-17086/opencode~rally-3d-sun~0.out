// Sun position (the SunCalc formulas).

export function sunPosition(date, lat, lng) {
  // Convert lat, lng to radians
  const latRad = lat * Math.PI / 180;
  const lngRad = lng * Math.PI / 180;
  
  // Calculate Julian Date
  const Jdn = julianDate(date);
  
  // Calculate mean anomaly
  const M = meanAnomaly(Jdn);
  
  // Calculate equation of center
  const C = equationOfCenter(M);
  
  // Calculate ecliptic longitude
  const L = eclipticLongitude(M + C);
  
  // Calculate declination
  const delta = declination(L);
  
  // Calculate local hour angle
  const H = localHourAngle(Jdn, latRad, lngRad);
  
  // Calculate altitude (elevation in radians)
  const alt = altitude(delta, H, latRad);
  
  // Calculate azimuth (bearing from North, clockwise in radians)
  const azimuth = azimuth2(delta, H, latRad, alt);
  
  return { alt, bearing: azimuth };
}

// ============= SunCalc Formulas =============

function julianDate(date) {
  const t = new Date(date);
  const y = t.getUTCFullYear();
  const m = t.getUTCMonth() + 1;
  const d = t.getUTCDate();
  const hh = t.getUTCHours();
  const mm = t.getUTCMinutes();
  const ss = t.getUTCSeconds();
  
  let A = Math.floor(y / 100);
  let J = Math.floor(y - A + 0.001 * A * (A - 1) / 4) +
          Math.floor((m + 1) / 12) * 365 +
          Math.floor((m + 1) / 12) * (3 * ((m + 1) / 12) / 12 + 1) +
          d - 0.5;
  
  J = J + Math.floor(30.6 * ((m + 1) / 12)) + 367 - 2 * A +
        Math.floor(0.075 * (A % 100)) - Math.floor(J / 36524) * 3 + 71 - 1524.5;
  
  J = J + hh / 24 + mm / (60 * 24) + ss / (60 * 60 * 24);
  return J;
}

function meanAnomaly(jdn) {
  const D = 359.923 / 360 * (jdn - 2451545);
  const M = 357.529 + D + 0.0003008 * D - 0.0000004 * D * D;
  return M;
}

function equationOfCenter(M) {
  const M_rad = M * Math.PI / 180;
  return 1.915 * Math.sin(M_rad) + 0.020 * Math.sin(2 * M_rad) + 0.0003 * Math.sin(3 * M_rad);
}

function eclipticLongitude(M_plus_C) {
  return 282.9404 + M_plus_C;
}

function declination(L) {
  const L_rad = L * Math.PI / 180;
  const e = 23.44;
  const delta = Math.asin(Math.sin(L_rad) * Math.sin(e * Math.PI / 180));
  return delta;
}

function localHourAngle(jdn, lat, lng) {
  const J0 = 2451545;
  const JDays = jdn - J0;
  const lngRad = lng * Math.PI / 180;
  
  // Calculate right ascension of mean sun
  const meanSunRA = sunRA(jdn);
  
  // Local sidereal time  
  const LST_deg = localSiderealTime(jdn, lng);
  
  // Hour angle = LST - RA (z

function sunRA(jdn) {
  const J0 = 2451545;
  const T = (jdn - J0) / 36525;
  const RA_deg = 280.46061837 + 360.98564736629 * (jdn - J0) + T * 4.092496 - T * T * 9.2881453;
  return RA_deg % 360;
}

function localSiderealTime(jdn, lng) {
  const J0 = 2451545;
  const JDays = jdn - J0;
  const LST_deg = 280.46061837 + 360.98564736629 * JDays + 0.000387933 * (JDays / 36525) * (JDays / 36525) - (JDays / 36525) * (JDays / 36525) * (JDays / 36525) * 0.000387933;
  return (LST_deg + lng * 360 / 365) % 360;
}

function altitude(delta, H, lat) {
  // delta, H, lat all in radians
  const alt = Math.asin(Math.sin(lat) * Math.sin(delta) + Math.cos(lat) * Math.cos(delta) * Math.cos(H));
  return alt;
}

function azimuth2(delta, H, lat, alt) {
  // Azimuth from North, clockwise in radians
  const sinAz = Math.sin(H) * Math.cos(lat) * Math.cos(delta) / Math.cos(alt);
  const cosAz = (Math.sin(lat) * Math.cos(delta) - Math.sin(alt) * Math.sin(lat)) / Math.cos(alt);
  // Actually cosAz = sin(delta) - sin(lat)*sin(alt) / (cos(lat)*cos(H)*cos(alt))
  // The formula simplifies to cosAz = (sin(delta) - sin(lat)*sin(alt)) / (cos(lat)*cos(H)*cos(alt))
  
  // More traditional formula:
  // bearing = atan2(sin(H), -tan(delta)/tan(lat))  - pi/2, normalized
  // Or: sin(Az) = cos(delta) * sin(H) / cos(alt)
  //      cos(Az) = (sin(delta) - sin(alt) * sin(lat)) / (sin(alt) * cos(lat))
  
  let bearing = Math.atan2(sinAz, cosAz);
  
  // Normalize to [0, 2*PI)
  let bearingRad = bearing;
  if (bearingRad < 0) bearingRad += 2 * Math.PI;
  
  return bearingRad;
}
