 import { fromFrame, cellOf } from './geometry.js';
 
 // Share of court samples shaded by trees/buildings at `date`, or null when the
-// sun is down. Port the trace in reference/viewer-shade.ts. Not implemented yet.
+// sun is down. Port of the trace in reference/viewer-shade.ts.
+
+const NONE = -32768; // sentinel: no obstacle in the cell
+
+/** Tallest obstacle in the venue, metres. */
+function maxTopOf(scene) {
+  let max = -Infinity;
+  for (let i = 0; i < scene.top.length; i++) {
+    const t = scene.top[i];
+    if (t !== NONE && t > max) max = t;
+  }
+  return max / 10;
+}
+
+/** Court sample points, in world coordinates, per court. */
+function samplePoints(scene) {
+  return scene.courts.map((f) => {
+    const out = [];
+    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4)
+      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) out.push(fromFrame(f, a, b));
+    return out;
+  });
+}
 
 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+  const s = sunPosition(date, scene.lat, scene.lng);
+  if (s.alt <= 0) return null;
+
+  const ex = Math.sin(s.bearing);
+  const ny = Math.cos(s.bearing);
+  const rise = Math.tan(s.alt);
+
+  const samples = samplePoints(scene);
+  const maxTop = maxTopOf(scene);
+  const { top, radius } = scene;
+
+  let shaded = 0;
+  let n = 0;
+  scene.courts.forEach((f, ci) => {
+    const h0 = f.z + 1;
+    const maxD = Math.min(radius * 1.5, (maxTop - h0) / rise);
+    for (const [px0, py0] of samples[ci]) {
+      n++;
+      for (let d = 0.5; d < maxD; d += 0.5) {
+        const c = cellOf(scene, px0 + ex * d, py0 + ny * d);
+        if (c < 0) break;
+        if (top[c] !== NONE && top[c] / 10 > h0 + d * rise) {
+          shaded++;
+          break;
+        }
+      }
+    }
+  });
+  return n ? shaded / n : 0;
 }
