import { sunPosition } from './src/sun.js';
import { shadeAt } from './src/shade.js';
import { readFileSync } from 'node:fs';
const deg = Math.PI/180;
// Seattle solar noon on 2026-06-21 ~13:10 PDT. expect alt ~ 90-47.6+23.44 = 65.8 deg, bearing ~180 (south)
for (const t of ['2026-06-21T20:10:00Z','2026-12-21T20:10:00Z']) {
  const s = sunPosition(new Date(t), 47.620116, -122.128019);
  console.log(t, 'alt', (s.alt/deg).toFixed(2)+'°', 'bearing', (s.bearing/deg).toFixed(2)+'°');
}
// equinox sunrise due east: expect bearing ~90 at sunrise, ~270 at sunset
for (const t of ['2026-03-20T14:00:00Z','2026-03-21T02:30:00Z']) {
  const s = sunPosition(new Date(t), 47.62, -122.13);
  console.log(t, 'alt', (s.alt/deg).toFixed(2)+'°', 'bearing', (s.bearing/deg).toFixed(2)+'°');
}
const scene = JSON.parse(readFileSync('venues/kenmore-inglemoor-hs.json','utf8'));
let t0 = performance.now(); let k = 0;
for (let m = 0; m < 24*60; m += 5) { shadeAt(scene, new Date(Date.UTC(2026,5,21,m+7))); k++; }
console.log('\n', k, 'forecast points (5-min over a day), 816 samples each:', (performance.now()-t0).toFixed(0)+' ms total');
"

