  const row = [];
  for (const t of times) {
    const a = shadeAt(scene, t), b = brute(scene, t);
    if (a !== b) { if (a === null || b === null || Math.abs(a-b) > 1e-12) throw new Error('MISMATCH '+t.toISOString()+' '+a+' vs '+b); }
    maxDiff = Math.max(maxDiff, a === null ? 0 : Math.abs(a-b));
    row.push(t.toISOString().slice(11,16) + ' ' + (a === null ? '  —' : (a*100).toFixed(1).padStart(5) + '%'));
  }
  for (let i = 0; i < row.length; i += 8) console.log('  ' + row.slice(i, i+8).join('  '));
}
console.log('\nmax |shadeAt - brute| =', maxDiff);
"


