import { readFileSync, readdirSync } from 'node:fs';
import { shadeAt } from './src/shade.js';
import { sunPosition } from './src/sun.js';

// Independent re-derivation of the README trace, written differently on purpose.
function brute(scene, date) {
  const s = sunPosition(date, scene.lat, scene.lng);
  if (s.alt <= 0) return null;
  const ex = Math.sin(s.bearing), ny = Math.cos(s.bearing), rise = Math.tan(s.alt);
  const tops = scene.top.filter(t => t !== -32768).map(t => t / 10);
  const maxTop = tops.length ? tops.reduce((a,b)=>Math.max(a,b)) : -3276.8;
  let shaded = 0, n = 0;
  for (const f of scene.courts) {
    const h0 = f.z + 1;
    const maxD = Math.min(scene.radius * 1.5, (maxTop - h0) / rise);
    const as = []; for (let a = -f.pl/2 + 0.6; a <= f.pl/2 + 1e-12; a += 1.4) as.push(a);
    const bs = []; for (let b = -f.pw/2 + 0.5; b <= f.pw/2 + 1e-12; b += 1.4) bs.push(b);
    for (const a of as) for (const b of bs) {
      const px = f.cx + Math.cos(f.theta)*a - Math.sin(f.theta)*b;
      const py = f.cy + Math.sin(f.theta)*a + Math.cos(f.theta)*b;
      n++;
      let d = 0.5, hit = false;
      while (d < maxD) {
        const i = Math.floor((px + ex*d + scene.radius) / scene.cell);
        const j = Math.floor((scene.radius - (py + ny*d)) / scene.cell);
        if (i < 0 || j < 0 || i >= scene.g || j >= scene.g) break;
        const t = scene.top[j*scene.g + i];
        if (t !== -32768 && t/10 > h0 + d*rise) { hit = true; break; }
        d += 0.5;
      }
      if (hit) shaded++;
    }
  }
  return n ? shaded / n : 0;
}

