+Looking at the request, I need to:
+
+1. **`src/sun.js`** — port `sunPosition` from `reference/sun.ts` (the SunCalc formulas).
+2. **`src/shade.js`** — port the trace from `reference/viewer-shade.ts`, using `sunPosition`, `fromFrame`, and `cellOf`. Compute `maxTop` (tallest obstacle, metres = max(topDm)/10), return `null` when `alt <= 0`, otherwise the shaded-sample share.
+
+The geometry helpers (`fromFrame`, `cellOf`) and the test file are already provided and shouldn't change. The trace details match the README exactly: sample loops (`a` from `-pl/2+0.6` to `pl/2`, `b` from `-pw/2+0.5` to `pw/2`, step 1.4 m), `ex = sin(bearing)`, `ny = cos(bearing)`, `rise = tan(alt)`, `h0 = court.z + 1`, `maxD = min(radius*1.5, (maxTop-h0)/rise)`, 0.5 m steps from `d = 0.5`, break on leaving the grid, shaded if `topDm[c]/10 > h0 + d*rise`.
+
+One subtlety: for the "flat venue" test, `maxTop` will be `-3276.8`, making `maxD` negative so the inner walk never runs and the result is `0`. For the "buried" test, `maxTop` is huge, `maxD` caps at `radius*1.5`, and the first step already finds a tall obstacle, so the result is `1`.
+
+src/sun.js
+````
+// Sun position (the SunCalc formulas), as the 3D view uses them.
+// Ported from reference/sun.ts.
+
+const rad = Math.PI / 180;
+
+export function sunPosition(date, lat, lng) {
+  const d = date.valueOf() / 86_400_000 - 0.5 + 2_440_588 - 2_451_545;
+  const M = rad * (357.5291 + 0.98560028 * d);
+  const C = rad * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M));
+  const L = M + C + rad * 102.9372 + Math.PI;
+  const e = rad * 23.4397;
+  const dec = Math.asin(Math.sin(e) * Math.sin(L));
+  const ra = Math.atan2(Math.sin(L) * Math.cos(e), Math.cos(L));
+  const H = rad * (280.16 + 360.9856235 * d) + rad * lng - ra;
+  const phi = rad * lat;
+  const alt = Math.asin(
+    Math.sin(phi) * Math.sin(dec) + Math.cos(phi) * Math.cos(dec) * Math.cos(H),
+  );
+  const az = Math.atan2(Math.sin(H), Math.cos(H) * Math.sin(phi) - Math.tan(dec) * Math.cos(phi));
+  return { alt, bearing: (az + Math.PI) % (2 * Math.PI) };
+}
+````
+
+src/shade.js
+````
+import { sunPosition } from './sun.js';
+import { fromFrame, cellOf } from './geometry.js';
+
+// Share of court samples shaded by trees/buildings at `date`, or null when the
+// sun is down. Ported from the trace in reference/viewer-shade.ts.
+
+export function shadeAt(scene, date) {
+  const s = sunPosition(date, scene.lat, scene.lng);
+  if (s.alt <= 0) return null;
+
+  const { radius: R, top: topDm, cell, g } = scene;
+
+  // Tallest obstacle in the venue, in metres (topDm is in decimetres).
+  let maxTopDm = -32768;
+  for (let i = 0; i < topDm.length; i++) if (topDm[i] > maxTopDm) maxTopDm = topDm[i];
+  const maxTop = maxTopDm / 10;
+
+  const ex = Math.sin(s.bearing);
+  const ny = Math.cos(s.bearing);
+  const rise = Math.tan(s.alt);
+
+  let shaded = 0;
+  let n = 0;
+
+  for (const f of scene.courts) {
+    const h0 = f.z + 1;
+    const maxD = Math.min(R * 1.5, (maxTop - h0) / rise);
+
+    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
+      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
+        n++;
+        const [px0, py0] = fromFrame(f, a, b);
+        for (let d = 0.5; d < maxD; d += 0.5) {
+          const c = cellOf(scene, px0 + ex * d, py0 + ny * d);
+          if (c < 0) break;
+          if (topDm[c] !== -32768 && topDm[c] / 10 > h0 + d * rise) {
+            shaded++;
+            break;
+          }
+        }
+      }
+    }
+  }
+
+  return n ? shaded / n : 0;
+}
+````
+
+Notes:
+- I left `src/geometry.js` and `test/shade.test.js` untouched as requested.
+- `cell` and `g` are destructured for clarity but the actual lookups go through the given `cellOf(scene, x, y)`, which reads `scene.radius`/`scene.cell`/`scene.g` directly — so `1 m` vs `2 m` cell grids both work.
+- The `maxTop` scan avoids `Math.max(...topDm)` spread (12,100 elements are within limits today, but a loop is safer for larger scenes).
