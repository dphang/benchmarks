+/** Tallest obstacle in the venue, in metres. */
+function maxObstacleTop(scene) {
+  let maxDm = -Infinity;
+  for (const dm of scene.top) {
+    if (dm !== NONE && dm > maxDm) maxDm = dm;
+  }
