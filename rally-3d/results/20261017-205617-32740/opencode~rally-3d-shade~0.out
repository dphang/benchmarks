The implementation matches the browser trace line for line. As a final check, I'll differential-test it against an independently written literal port on randomized scenes (varied `cell`, court rotation, `z`, and obstacle heights).
[0m$ [0mnode --input-type=module -e "
import { shadeAt } from './src/shade.js';
import { sunPosition } from './src/sun.js';
import { fromFrame, cellOf } from './src/geometry.js';

// Independent literal transcription of reference/viewer-shade.ts.
function ref(scene, date) {
  const s = sunPosition(date, scene.lat, scene.lng);
  if (s.alt <= 0) return null;
  const R = scene.radius, topDm = scene.top;
  let maxTop = -Infinity;
  for (const v of topDm) if (v !== -32768 && v / 10 > maxTop) maxTop = v / 10;
  const samples = scene.courts.map((f) => {
    const out = [];
    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4)
      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) out.push(fromFrame(f, a, b));
    return out;
  });
  const ex = Math.sin(s.bearing), ny = Math.cos(s.bearing), rise = Math.tan(s.alt);
  let shaded = 0, n = 0;
  scene.courts.forEach((f, ci) => {
    const h0 = f.z + 1;
    const maxD = Math.min(R * 1.5, (maxTop - h0) / rise);
    for (const [px0, py0] of samples[ci]) {
      n++;
      for (let d = 0.5; d < maxD; d += 0.5) {
        const c = cellOf(scene, px0 + ex * d, py0 + ny * d);
        if (c < 0) break;
        if (topDm[c] !== -32768 && topDm[c] / 10 > h0 + d * rise) { shaded++; break; }
      }
    }
  });
  return n ? shaded / n : 0;
}

let seed = 12345;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 2 ** 32);
let bad = 0;
for (let t = 0; t < 40; t++) {
  const g = 40, cell = 0.75 + rnd() * 2.5, radius = (g * cell) / 2;
  const top = Array.from({ length: g * g }, () => rnd() < 0.7 ? -32768 : Math.floor(-50 + rnd() * 700));
  const courts = Array.from({ length: 1 + Math.floor(rnd() * 4) }, () => ({
    sport: 'x', cx: (rnd() - 0.5) * radius, cy: (rnd() - 0.5) * radius,
    theta: rnd() * 2 * Math.PI, pl: 5 + rnd() * 25, pw: 3 + rnd() * 12,
    AL: 20, AW: 10, z: (rnd() - 0.5) * 4,
  }));
  const scene = { lat: 47 + rnd(), lng: -122 - rnd(), radius, cell, g, courts, top };
  for (const iso of ['2026-01-15T18:00:00Z', '2026-06-21T20:00:00Z', '2026-09-01T16:30:00Z']) {
    const a = shadeAt(scene, new Date(iso)), b = ref(scene, new Date(iso));
    if (a !== b) { bad++; console.log('mismatch', t, iso, a, b); }
  }
}
console.log(bad === 0 ? 'all 120 randomized cases match' : bad + ' mismatches');
"
all 120 randomized cases match
> build · bench-model
Implemented the headless port.

**`src/sun.js`**
- Ported the SunCalc formulas from `reference/sun.ts` exactly, returning `{ alt, bearing }` in radians with bearing wrapped to `[0, 2π)`.

**`src/shade.js`**
- Computes the sun position and returns `null` when `alt <= 0`.
- Builds court sample points with the 1.4 m grid and `fromFrame`.
- Computes `maxTop` as the tallest non-sentinel obstacle in decimetres ÷ 10.
- Traces 0.5 m steps toward the sun up to `min(radius * 1.5, (maxTop - h0) / rise)`, using the supplied `cellOf`, stopping when leaving the grid.
- Returns shaded samples ÷ total samples, or `0` when there are no samples.

Verification:
- `node --test` — all 4 visible tests pass.
- Random differential test against an independent literal transcription of `viewer-shade.ts` — 120/120 cases match.
- `test/shade.test.js` was left untouched.
