      77 src/shade.js
import { sunPosition } from './sun.js';
import { fromFrame, cellOf } from './geometry.js';

/**
 * Compute how much of the courts are shaded at a given date.
 * @param {Object} scene - The venue scene with lat, lng, radius, cell, g, courts, top
 * @param {Date} date - The date to compute for
 * @returns {number|null} - Share of shaded samples (0-1), or null if sun is below horizon
 */
export function shadeAt(scene, date) {
  const s = sunPosition(date, scene.lat, scene.lng);
  console.log('[shadeAt] sun.alt=' + s.alt + ' bearing=' + s.bearing);
  
  // Return null if sun is at or below horizon
  if (s.alt <= 0) {
    return null;
  }
  
  const ex = Math.sin(s.bearing);
  const ny = Math.cos(s.bearing);
  const rise = Math.tan(s.alt);
  console.log('[shadeAt] ex=' + ex + ' ny=' + ny + ' rise=' + rise);
  
  // Find maxTop (tallest obstacle in the venue, in metres)
