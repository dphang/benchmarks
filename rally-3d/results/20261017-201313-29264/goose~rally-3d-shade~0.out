All 4 tests pass! Now let me remove the debug statements and keep the implementation clean:


  ────────────────────────────────────────
  ▸ write
    path src/shade.js
    content: import { sunPosition } from './sun.js';
import { fromFrame, cellOf } from './geometry.js';

/**
 * Compute how much of the courts are shaded at a given date.
 * @param {Object} scene - The venue scene with lat, lng, radius, cell, g, courts, top
 * @param {Date} date - The date to compute for
 * @returns {number|null} - Share of shaded samples (0-1), or null if sun is below horizon
 */
export function shadeAt(scene, date) {
  const s = sunPosition(date, scene.lat, scene.lng);
  
  // Return null if sun is at or below horizon
  if (s.alt <= 0) {
    return null;
  }
  
  const ex = Math.sin(s.bearing);
  const ny = Math.cos(s.bearing);
  const rise = Math.tan(s.alt);
  
  // Find maxTop (tallest obstacle in the venue, in metres)
  // top is in decimetres, -32768 = none
  let maxTop = -Infinity;
  for (const h of scene.top) {
    if (h > -32768) {
      maxTop = Math.max(maxTop, h / 10);
    }
  }
  
  let shaded = 0;
  let n = 0;
  
  for (const f of scene.courts) {
    const h0 = f.z + 1;
    const maxD = Math.min(scene.radius * 1.5, (maxTop - h0) / rise);
    
    // Sample points for this court
    const samples = [];
    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
        samples.push(fromFrame(f, a, b));
      }
    }
    
    for (const [px0, py0] of samples) {
      n++;
      for (let d = 0.5; d < maxD; d += 0.5) {
        const c = cellOf(px0 + ex * d, py0 + ny * d);
        if (c < 0) break;
        // top is in decimetres, divided by 10 for metres
        const obstacleHeight = scene.top[c] / 10;
        if (obstacleHeight > -32768 && obstacleHeight > h0 + d * rise) {
          shaded++;
          break;
        }
      }
    }
  }
  
  return n ? shaded / n : 0;
}


