    command: cd work/weak/goose/rally-3d-shade-0 && node -e "
// Manual trace of shadeAt WITHOUT any imports
// to verify the algorithm is correct

const sunPosition = async (date, lat, lng) => {
  const rad = Math.PI / 180;
  const d = date.valueOf() / 86_400_000 - 0.5 + 2_440_588 - 2_451_545;
  const M = rad * (357.5291 + 0.98560028 * d);
  const C = rad * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M));
  const L = M + C + rad * 102.9372 + Math.PI;
  const e = rad * 23.4397;
  const dec = Math.asin(Math.sin(e) * Math.sin(L));
  const ra = Math.atan2(Math.sin(L) * Math.cos(e), Math.cos(L));
  const H = rad * (280.16 + 360.9856235 * d) + rad * lng - ra;
  const phi = rad * lat;
  const alt = Math.asin(
    Math.sin(phi) * Math.sin(dec) + Math.cos(phi) * Math.cos(dec) * Math.cos(H),
  );
  const az = Math.atan2(Math.sin(H), Math.cos(H) * Math.sin(phi) - Math.tan(dec) * Math.cos(phi));
  return { alt, bearing: (az + Math.PI) % (2 * Math.PI) };
};

// fromFrame
function fromFrame(f, a, b) {
  return [
    f.cx + Math.cos(f.theta) * a - Math.sin(f.theta) * b,
    f.cy + Math.sin(f.theta) * a + Math.cos(f.theta) * b,
  ];
}

// cellOf  
function cellOf(scene, x, y) {
  const i = Math.floor((x + scene.radius) / scene.cell);
  const j = Math.floor((scene.radius - y) / scene.cell);
  if (i < 0 || j < 0 || i >= scene.g || j >= scene.g) return -1;
  return j * scene.g + i;
}

const scene = {
  lat: 47.6, lng: -122.3, radius: 110, cell: 2, g: 110,
  courts: [{ sport: 'tennis', cx: 0, cy: 0, theta: 0, pl: 23.77, pw: 10.97, AL: 36.6, AW: 18.3, z: 0 }],
  top: new Array(110 * 110).fill(32767),
};

const date = new Date('2026-06-21T20:00:00Z');
const s = sunPosition(date, scene.lat, scene.lng);
console.log('s:', s);

if (s.alt <= 0) {
  console.log('SUN DOWN');
  process.exit(0);
}

const ex = Math.sin(s.bearing);
const ny = Math.cos(s.bearing);
const rise = Math.tan(s.alt);
console.log('ex,ny,rise:', ex, ny, rise);

let maxTop = -Infinity;
for (const h of scene.top) {
  if (h > -32768) { maxTop = Math.max(maxTop, h / 10); }
}
console.log('maxTop:', maxTop);

console.log('=== Shading algorithm ===');
let shaded = 0;
let n = 0;

for (const f of scene.courts) {
  const h0 = f.z + 1;
  const maxD = Math.min(scene.radius * 1.5, (maxTop - h0) / rise);
  console.log('Court h0, maxD:', h0, maxD);
  
  const samples = [];
  for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
    for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
      samples.push(fromFrame(f, a, b));
    }
  }
  console.log('Samples:', samples.length);
  
  for (const [px0, py0] of samples) {
    n++;
    console.log('Sample ' + n, px0, py0);
    for (let d = 0.5; d < maxD; d += 0.5) {
      const c = cellOf(scene, px0 + ex * d, py0 + ny * d);
      if (c < 0) {
        console.log('  d=' + d + ' c=' + c + ' OUT OF GRID');
        break;
      }
      const obstacleHeight = scene.top[c] / 10;
      const threshold = h0 + d * rise;
      if (obstacleHeight > -32768 && obstacleHeight > threshold) {
        shaded++;
        console.log('  SHADED at d=' + d);
        break;
      }
    }
  }
}

console.log('Results: n=' + n + ' shaded=' + shaded + ' ratio=' + (n ? shaded/n : 0));
"


