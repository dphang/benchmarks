+    const samples = [];
+    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
+      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
+        samples.push(fromFrame(f, a, b));
+      }
+    }
+    console.log('[shadeAt] samples count=' + samples.length);
+    
+    for (const [px0, py0] of samples) {
+      n++;
+      console.log('[shadeAt] sample ' + n + ': (' + px0 + ', ' + py0 + ')');
+      let shadedLoop = false;
+      for (let d = 0.5; d < maxD; d += 0.5) {
+        const c = cellOf(px0 + ex * d, py0 + ny * d);
+        if (c < 0) {
+          console.log('[shadeAt]   d=' + d + ' c=' + c + ' out of bound, break');
+          break;
+        }
+        // top is in decimetres, divided by 10 for metres
+        const obstacleHeight = scene.top[c] / 10;
+        const thresh = h0 + d * rise;
+        console.log('[shadeAt]   d=' + d + ' c=' + c + ' h=' + obstacleHeight + ' t=' + thresh + ' shaded?' + (obstacleHeight > thresh));
+        if (obstacleHeight > -32768 && obstacleHeight > h0 + d * rise) {
+          shadedLoop = true;
+          shaded++;
+          break;
+        }
+      }
+      if (!shadedLoop) console.log('[shadeAt]   NOT SHADED');
+    }
+  }
+  
+  console.log('[shadeAt] final: n=' + n + ' shaded=' + shaded + ' ratio=' + (n ? shaded / n : 0));
+  return n ? shaded / n : 0;
 }
