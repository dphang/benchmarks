 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+  console.log('[shadeAt] scene.lat=' + scene.lat + ' scene.lng=' + scene.lng + ' scene.radius=' + scene.radius);
+  const s = sunPosition(date, scene.lat, scene.lng);
+  console.log('[shadeAt] sun.alt=' + s.alt + ' bearing=' + s.bearing);
+  
+  // Return null if sun is at or below horizon
+  if (s.alt <= 0) {
+    return null;
+  }
+  
+  const ex = Math.sin(s.bearing);
+  const ny = Math.cos(s.bearing);
+  const rise = Math.tan(s.alt);
+  console.log('[shadeAt] ex=' + ex + ' ny=' + ny + ' rise=' + rise);
+  
+  // Find maxTop (tallest obstacle in the venue, in metres)
+  // top is in decimetres, -32768 = none
+  let maxTop = -Infinity;
+  for (const h of scene.top) {
+    if (h > -32768) {
+      maxTop = Math.max(maxTop, h / 10);
+    }
+  }
+  console.log('[shadeAt] maxTop=' + maxTop + ' scene.top[0]=' + scene.top[0]);
+  
+  let shaded = 0;
+  let n = 0;
+  
+  for (const f of scene.courts) {
+    const h0 = f.z + 1;
