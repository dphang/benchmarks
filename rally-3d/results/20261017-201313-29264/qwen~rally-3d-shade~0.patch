@@ -2,8 +2,51 @@ import { sunPosition } from './sun.js';
 import { fromFrame, cellOf } from './geometry.js';
 
 // Share of court samples shaded by trees/buildings at `date`, or null when the
-// sun is down. Port the trace in reference/viewer-shade.ts. Not implemented yet.
+// sun is down. Port the trace in reference/viewer-shade.ts.
 
 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+  const s = sunPosition(date, scene.lat, scene.lng);
+  if (s.alt <= 0) return null;
+
+  const ex = Math.sin(s.bearing);
+  const ny = Math.cos(s.bearing);
+  const rise = Math.tan(s.alt);
+
+  // maxTop is the highest obstacle in decimetms; convert to metres
+  const maxTop = Math.max(...scene.top) / 10;
+
+  // Generate samples by court
+  const samplesByCourt = [];
+  for (const f of scene.courts) {
+    const out = [];
+    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
+      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
+        out.push(fromFrame(f, a, b));
+      }
+    }
+    samplesByCourt.push(out);
+  }
+
+  let shaded = 0;
+  const total = samplesByCourt.reduce((sum, s) => sum + s.length, 0);
+
+  for (let ci = 0; ci < samplesByCourt.length; ci++) {
+    const h0 = scene.courts[ci].z + 1;
+    // maxD is from the sample point toward the sun; limited by horizon
+    const maxD = Math.min(scene.radius * 1.5, (maxTop - h0) / rise);
+    for (const [px0, py0] of samplesByCourt[ci]) {
+      for (let d = 0.5; d < maxD; d += 0.5) {
+        const c = cellOf(scene, px0 + ex * d, py0 + ny * d);
+        if (c < 0) break;
+        const topVal = scene.top[c];
+        // topVal is in decimetres; convert to metres for h comparison
+        if (topVal !== -32768 && topVal / 10 > h0 + d * rise) {
+          shaded++;
+          break;
+        }
+      }
+    }
+  }
+
+  return total ? shaded / total : 0;
 }
