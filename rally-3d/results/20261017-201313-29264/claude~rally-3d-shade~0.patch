+import { sunPosition } from './sun.js';
+import { cellOf } from './geometry.js';
 
+/**
+ * How much of the courts a venue's trees and buildings shade at `date`.
+ * Returns the share of court sample points in shadow (0–1) if sun is up,
+ * or null if the sun is at or below the horizon.
+ */
 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
-}
+  const s = sunPosition(date, scene.lat, scene.lng);
+  if (s.alt <= 0) return null;
+
+  // Find the tallest obstacle (in decimetres)
+  let maxTop = -32768;
+  for (let i = 0; i < scene.top.length; i++) {
+    if (scene.top[i] > maxTop) {
+      maxTop = scene.top[i];
+    }
+  }
+
+  // Build sample points per court: (x, y) in world coordinates
+  const samples = scene.courts.map((f) => {
+    const out = [];
+    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
+      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
+        out.push([f.cx + Math.cos(f.theta) * a - Math.sin(f.theta) * b,
+                  f.cy + Math.sin(f.theta) * a + Math.cos(f.theta) * b]);
+      }
+    }
+    return out;
+  });
+
+  const ex = Math.sin(s.bearing);
+  const ny = Math.cos(s.bearing);
+  const rise = Math.tan(s.alt);
+
+  let shaded = 0;
+  let n = 0;
+
+  scene.courts.forEach((f, ci) => {
+    const h0 = f.z + 1;
+    const maxD = Math.min(scene.radius * 1.5, (maxTop - h0) / rise);
+    for (const [px0, py0] of samples[ci]) {
+      n++;
+      for (let d = 0.5; d < maxD; d += 0.5) {
+        const c = cellOf(scene, px0 + ex * d, py0 + ny * d);
+        if (c < 0) break;
+        if (scene.top[c] !== -32768 && scene.top[c] / 10 > h0 + d * rise) {
+          shaded++;
+          break;
+        }
+      }
+    }
+  });
+
+  return n ? shaded / n : 0;
+}
