--- a/src/shade.js
+++ b/src/shade.js
@@ -5,5 +5,44 @@ import { fromFrame, cellOf } from './geometry.js';
 // sun is down. Port the trace in reference/viewer-shade.ts. Not implemented yet.
 
 export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+  const s = sunPosition(date, scene.lat, scene.lng);
+  if (s.alt <= 0) return null;
+
+  const ex = Math.sin(s.bearing);
+  const ny = Math.cos(s.bearing);
+  const rise = Math.tan(s.alt);
+
+  // Compute maxTop from the gz top array (decimetres)
+  const maxTop = Math.max(...scene.top);
+
+  let shaded = 0;
+  let total = 0;
+
+  for (const court of scene.courts) {
+    const h0 = court.z + 1;
+    const maxD = Math.min(scene.radius * 1.5, (maxTop - h0) / rise);
+
+    // Sample points in court frame: a along length, b across
+    for (let a = -court.pl / 2 + 0.6; a <= court.pl / 2; a += 1.4) {
+      for (let b = -court.pw / 2 + 0.5; b <= court.pw / 2; b += 1.4) {
+        const [px, py] = fromFrame(court, a, b);
+        total++;
+
+        // Walk toward the sun from d = 0.5
+        for (let d = 0.5; d < maxD; d += 0.5) {
+          const cx = px + ex * d;
+          const cy = py + ny * d;
+          const c = cellOf(scene, cx, cy);
+          if (c < 0) break;
+          const topHeight = scene.top[c] / 10; // decimetres -> metres
+          if (topHeight > h0 + d * rise) {
+            shaded++;
+            break;
+          }
+        }
+      }
+    }
+  }
+
+  return total ? shaded / total : 0;
 }
