+src/shade.js
+````javascript
+import { sunPosition } from './sun.js';
+import { fromFrame, cellOf } from './geometry.js';
+
+/**
+ * How much of the courts a venue's trees and buildings shade at `date`.
+ * Returns 0-1 (share of samples in shadow) or null when sun is down.
+ */
+export function shadeAt(scene, date) {
+  const s = sunPosition(date, scene.lat, scene.lng);
+  
+  // If sun is at or below horizon, return null
+  if (s.alt <= 0) {
+    return null;
+  }
+  
+  const ex = Math.sin(s.bearing);
+  const ny = Math.cos(s.bearing);
+  const rise = Math.tan(s.alt);
+  
+  // Find maxTop (tallest obstacle in decimetres)
+  let maxTop = 0;
+  for (const h of scene.top) {
+    if (h > maxTop) {
+      maxTop = h;
+    }
+  }
+  
+  // Convert maxTop from decimetres to metres
+  const maxTopM = maxTop / 10;
+  
+  // Collect all sample points from all courts
+  const samples = [];
+  for (const f of scene.courts) {
+    const courtSamples = [];
+    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
+      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
+        const [px, py] = fromFrame(f, a, b);
+        courtSamples.push([px, py]);
+      }
+    }
+    samples.push(courtSamples);
+  }
+  
+  // Count total samples and shaded samples
+  let total = 0;
+  let shaded = 0;
+  
+  for (let ci = 0; ci < samples.length; ci++) {
+    const h0 = scene.courts[ci].z + 1;
+    const maxD = Math.min(scene.radius * 1.5, (maxTopM - h0) / rise);
+    
+    for (const [px0, py0] of samples[ci]) {
+      total++;
+      for (let d = 0.5; d < maxD; d += 0.5) {
+        const c = cellOf(scene, px0 + ex * d, py0 + ny * d);
+        if (c < 0) break;
+        if (scene.top[c] !== -32768 && scene.top[c] / 10 > h0 + d * rise) {
+          shaded++;
+          break;
+        }
+      }
+    }
+  }
+  
+  return total ? shaded / total : 0;
+}
+````
