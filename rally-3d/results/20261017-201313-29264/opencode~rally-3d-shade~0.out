[0m← [0mEdit src/shade.js
Index: src/shade.js
===================================================================
--- src/shade.js
+++ src/shade.js
@@ -1,9 +1,49 @@
 import { sunPosition } from './sun.js';
 import { fromFrame, cellOf } from './geometry.js';
 
 // Share of court samples shaded by trees/buildings at `date`, or null when the
-// sun is down. Port the trace in reference/viewer-shade.ts. Not implemented yet.
+// sun is down. Port the trace in reference/viewer-shade.ts.
 
-export function shadeAt(scene, date) {
-  throw new Error('shadeAt is not implemented');
+function shadeAt(scene, date) {
+  const s = sunPosition(date, scene.lat, scene.lng);
+  if (s.alt <= 0) return null;
+
+  const ex = Math.sin(s.bearing);
+  const ny = Math.cos(s.bearing);
+  const rise = Math.tan(s.alt);
+  let shaded = 0;
+  let n = 0;
+
+  // Find maxTop - the tallest obstacle in the venue
+  let maxTop = -32768;
+  for (const t of scene.top) {
+    if (t > maxTop) maxTop = t;
+  }
+
+  // For each court, generate samples
+  for (let ci = 0; ci < scene.courts.length; ci++) {
+    const f = scene.courts[ci];
+    const h0 = f.z + 1;
+    const maxD = Math.min(scene.radius * 1.5, (maxTop - h0) / rise);
+
+    for (let a = -f.pl / 2 + 0.6; a <= f.pl / 2; a += 1.4) {
+      for (let b = -f.pw / 2 + 0.5; b <= f.pw / 2; b += 1.4) {
+        const [px0, py0] = fromFrame(f, a, b);
+        n++;
+
+        for (let d = 0.5; d < maxD; d += 0.5) {
+          const c = cellOf(px0 + ex * d, py0 + ny * d);
+          if (c < 0) break;
+          if (scene.top[c] !== -32768 && scene.top[c] / 10 > h0 + d * rise) {
+            shaded++;
+            break;
+          }
+        }
+      }
+    }
+  }
+
+  return n ? shaded / n : 0;
 }
+
+export { shadeAt };

