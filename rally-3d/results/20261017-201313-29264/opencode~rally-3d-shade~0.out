> build · bench-model
Now I understand the structure. Let me implement both files:

1. **src/sun.js** - Port the SunCalc formulas from reference/sun.ts
2. **src/shade.js** - Port the shade tracing from reference/viewer-shade.ts
[0m← [0mEdit src/sun.js
Index: src/sun.js
===================================================================
--- src/sun.js
+++ src/sun.js
@@ -1,6 +1,21 @@
 // Sun position (the SunCalc formulas), as the 3D view uses them.
-// Port reference/sun.ts. Not implemented yet.
+// Port reference/sun.ts.
 
-export function sunPosition(date, lat, lng) {
-  throw new Error('sunPosition is not implemented');
+function sunPosition(date, lat, lng) {
+  const d = date.valueOf() / 86_400_000 - 0.5 + 2_440_588 - 2_451_545;
+  const M = (Math.PI / 180) * (357.5291 + 0.98560028 * d);
+  const C = (Math.PI / 180) * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M));
+  const L = M + C + (Math.PI / 180) * 102.9372 + Math.PI;
+  const e = (Math.PI / 180) * 23.4397;
+  const dec = Math.asin(Math.sin(e) * Math.sin(L));
+  const ra = Math.atan2(Math.sin(L) * Math.cos(e), Math.cos(L));
+  const H = (Math.PI / 180) * (280.16 + 360.9856235 * d) + (Math.PI / 180) * lng - ra;
+  const phi = (Math.PI / 180) * lat;
+  const alt = Math.asin(
+    Math.sin(phi) * Math.sin(dec) + Math.cos(phi) * Math.cos(dec) * Math.cos(H),
+  );
+  const az = Math.atan2(Math.sin(H), Math.cos(H) * Math.sin(phi) - Math.tan(dec) * Math.cos(phi));
+  return { alt, bearing: (az + Math.PI) % (2 * Math.PI) };
 }
+
+export { sunPosition };

